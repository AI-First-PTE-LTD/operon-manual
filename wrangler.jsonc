// Worker for the customer manual (design §5.1). Deployed to the Cloudflare account that holds the staffonai.com zone;
// see README "Deploy". @astrojs/cloudflare merges this file into the generated
// dist/server/wrangler.json; Starlight pages are served as static assets and only /keystatic and /api/keystatic run on
// the Worker. No D1, R2 or KV bindings.
//
// Secrets for Keystatic GitHub mode (names only; values live in Infisical and are set with `wrangler secret put`):
//   KEYSTATIC_GITHUB_CLIENT_ID, KEYSTATIC_GITHUB_CLIENT_SECRET, KEYSTATIC_SECRET
// Build-time variables: PUBLIC_KEYSTATIC_STORAGE=github, PUBLIC_KEYSTATIC_GITHUB_APP_SLUG, SITE_URL
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "operon-manual",
  "compatibility_date": "2026-10-19"
}
